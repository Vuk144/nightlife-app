# ---------------------------------------------------------------------------
#  nightlife-ingestion — environment
#
#  Copy this file to `ingestion/.env` and fill in the values.
#  `ingestion/.env` is git-ignored and MUST NEVER be committed.
#
#  SUPABASE_SERVICE_ROLE_KEY is a privileged, RLS-bypassing key.
#    - It belongs ONLY to this ingestion runner.
#    - It must NEVER appear in the Expo app, in any EXPO_PUBLIC_* variable,
#      in app source, or in a committed file.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase service-role key (Project Settings -> API -> service_role secret).
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional overrides (sensible defaults are built in) --------------------

# Overpass API endpoint (read-only). Never the OSM editing API.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# User-Agent sent with Overpass requests. Include a contact URL or email.
# OVERPASS_USER_AGENT=nightlife-app-ingestion/0.1 (+https://github.com/Vuk144/nightlife-app-v2)
